GLIP_ENVIRONMENT=development
GLIP_DATABASE_URL=sqlite:///./glip.db
GLIP_CORS_ORIGINS=http://localhost:5174
GLIP_REQUIRE_MIGRATION_HEAD=false

# Human authentication. Production target: native_session.
GLIP_AUTH_MODE=dev_headers
GLIP_AUTH_SESSION_COOKIE_NAME=glip_session
GLIP_AUTH_SESSION_SECRET=
GLIP_AUTH_PASSWORD_PEPPER=
GLIP_AUTH_SESSION_TTL_SECONDS=28800
GLIP_AUTH_IDLE_TTL_SECONDS=1800
GLIP_AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
GLIP_AUTH_PASSWORD_MIN_LENGTH=12
GLIP_AUTH_PASSWORD_MAX_LENGTH=256
GLIP_AUTH_SCRYPT_N=16384
GLIP_AUTH_SCRYPT_R=8
GLIP_AUTH_SCRYPT_P=1
GLIP_AUTH_MAX_FAILED_ATTEMPTS=8
GLIP_AUTH_LOCKOUT_SECONDS=900

# ORKIO/Efatà starts disabled for standalone deployment.
GLIP_ORKIO_MODE=disabled
GLIP_ORKIO_BASE_URL=
GLIP_ORKIO_M2M_TOKEN=
GLIP_ORKIO_CAPABILITY_EXECUTE_PATH=
GLIP_ORKIO_PROBE_TIMEOUT_SECONDS=5
GLIP_ORKIO_TIMEOUT_SECONDS=20
GLIP_ORKIO_MAX_ATTEMPTS=2
GLIP_ORKIO_RETRY_BACKOFF_SECONDS=0.25
GLIP_ORKIO_CIRCUIT_FAILURE_THRESHOLD=4
GLIP_ORKIO_CIRCUIT_COOLDOWN_SECONDS=20
GLIP_ORKIO_EXECUTION_LEASE_SECONDS=90
GLIP_ORKIO_CAPABILITY_CONTRACT_VERSION=ORKIO-CAPABILITY-REQUEST-1
GLIP_ORKIO_RESPONSE_CONTRACT_VERSION=ORKIO-RESPONSE-1

GLIP_REALTIME_MODE=pending_external
GLIP_VOICE_MODE=pending_external
GLIP_AVATAR_MODE=pending_external

GLIP_RELEASE_ID=local
GLIP_DEPLOYMENT_ID=
GLIP_REPLICA_ID=


# GLIP-owned artifact runtime. Never reuse Efata tokens, billing or storage namespace.
GLIP_ARTIFACTS_ENABLED=false
GLIP_ARTIFACT_STORAGE_BACKEND=local
GLIP_ARTIFACT_STORAGE_PATH=./data/glip-artifacts
GLIP_ARTIFACT_STORAGE_BUCKET=
GLIP_ARTIFACT_STORAGE_REGION=us-east-1
GLIP_ARTIFACT_STORAGE_ENDPOINT_URL=
GLIP_ARTIFACT_STORAGE_ACCESS_KEY_ID=
GLIP_ARTIFACT_STORAGE_SECRET_ACCESS_KEY=
GLIP_ARTIFACT_STORAGE_SSE=AES256
GLIP_ARTIFACT_STORAGE_KMS_KEY_ID=
GLIP_ARTIFACT_STORAGE_PREFIX=glip
GLIP_ARTIFACT_PROVIDER_PROFILE_REF=glip-local
GLIP_MAX_ARTIFACT_BYTES=50000000

# CAD/BIM source foundation. In staging/production, the same GLIP-isolated S3-compatible
# storage is required. IFC remains semantic source; GLB/glTF is derived distribution.
GLIP_ARCHITECTURE_UPLOADS_ENABLED=false
GLIP_MAX_ARCHITECTURAL_SOURCE_BYTES=250000000


# BIM semantic worker (isolated from the web process)
GLIP_BIM_SEMANTIC_ENABLED=false
GLIP_BIM_SEMANTIC_ENGINE=ifcopenshell
GLIP_BIM_SEMANTIC_MAX_ELEMENTS=100000
GLIP_BIM_JOB_LEASE_SECONDS=300


# CAD semantic worker (DXF only in RC7; DWG requires an external Autodesk/ODA adapter)
GLIP_CAD_SEMANTIC_ENABLED=false
GLIP_CAD_SEMANTIC_ENGINE=ezdxf
GLIP_CAD_SEMANTIC_MAX_ENTITIES=100000
GLIP_CAD_JOB_LEASE_SECONDS=300

# Deterministic source-linework GLB preview. This is not inferred architectural 3D.
GLIP_GEOMETRY_BUILD_ENABLED=false
GLIP_GEOMETRY_PREVIEW_ENGINE=trimesh
GLIP_GEOMETRY_PREVIEW_MAX_PATHS=20000
GLIP_GEOMETRY_PREVIEW_MAX_POINTS=500000
GLIP_GEOMETRY_JOB_LEASE_SECONDS=300

# Pricing plane remains off until versioned market-source ingestion is implemented.
GLIP_PRICING_INTELLIGENCE_ENABLED=false
