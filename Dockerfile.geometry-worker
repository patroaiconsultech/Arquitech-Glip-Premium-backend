FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY requirements.lock.txt requirements.geometry-worker.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt -r requirements.geometry-worker.lock.txt

COPY src ./src
COPY scripts ./scripts
COPY migrations ./migrations
COPY alembic.ini ./

# Choose GLIP_GEOMETRY_WORKER_MODE=cad or geometry at runtime.
CMD ["sh","-c","if [ \"${GLIP_GEOMETRY_WORKER_MODE:-cad}\" = \"geometry\" ]; then python scripts/process_geometry_jobs.py; else python scripts/process_cad_jobs.py; fi"]
